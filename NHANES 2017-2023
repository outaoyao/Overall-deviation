  cell<-function(L,g=NULL){den<-!is.na(d[[v]])&(if(is.null(g))TRUE else d$PHQ9_group==g);num<-den&as.character(d[[v]])==L
  sprintf("%s (%.1f%%)",format(sum(num),big.mark=","),100*sum(d$mec_adj[num])/sum(d$mec_adj[den]))}
  map_dfr(seq_along(lev),function(i)tibble(Characteristic=if(i==1)unname(labs[v]) else "",Category=lev[i],Overall=cell(lev[i]),
                                           `PHQ-9 <10`=cell(lev[i],"PHQ-9 <10"),`PHQ-9 ≥10`=cell(lev[i],"PHQ-9 ≥10"),`P value`=if(i==1)fmtp(p) else ""))
}


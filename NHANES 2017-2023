recode_phq<-function(x){x<-suppressWarnings(as.numeric(x)); case_when(
  x==1~0,x==2~1,x==3~2,x==4~3,TRUE~NA_real_)}

process_phq_cycle<-function(table_name,cycle_label){
  d<-nhanes(table_name); v<-c("SEQN",paste0("DPQ0",seq(10,90,10)))
  miss<-setdiff(v,names(d)); if(length(miss)) stop("Missing variables: ",paste(miss,collapse=", "))
  d %>% select(all_of(v)) %>% mutate(
    SEQN=as.numeric(SEQN),across(DPQ010:DPQ090,recode_phq),
    PHQ9_ITEM_MISSING_N=rowSums(is.na(pick(DPQ010:DPQ090))),
    PHQ9_SCORE=ifelse(PHQ9_ITEM_MISSING_N==0,rowSums(pick(DPQ010:DPQ090)),NA_real_),
    PHQ9_no_sleep_ITEM_MISSING_N=rowSums(is.na(pick(DPQ010,DPQ020,DPQ040:DPQ090))),
    PHQ9_no_sleep_SCORE=ifelse(PHQ9_no_sleep_ITEM_MISSING_N==0,
                               rowSums(pick(DPQ010,DPQ020,DPQ040:DPQ090)),NA_real_),
    PHQ9_depression_above_10=case_when(PHQ9_SCORE>=10~1,PHQ9_SCORE<10~0,TRUE~NA_real_),
    Moderate_depression_above=PHQ9_depression_above_10,
    PHQ9_depression_above_15=case_when(PHQ9_SCORE>=15~1,PHQ9_SCORE<15~0,TRUE~NA_real_),
    ModSevere_depression_above=PHQ9_depression_above_15,
    PHQ9_no_sleep_depression_above_10=case_when(PHQ9_no_sleep_SCORE>=10~1,
                                                PHQ9_no_sleep_SCORE<10~0,TRUE~NA_real_),
    PHQ9_no_sleep_depression_above_9=case_when(PHQ9_no_sleep_SCORE>=9~1,
                                               PHQ9_no_sleep_SCORE<9~0,TRUE~NA_real_),
    suicidal_ideation_any=case_when(DPQ090>=1~1,DPQ090==0~0,TRUE~NA_real_),
    suicidal_ideation_daily=case_when(DPQ090==3~1,DPQ090<3~0,TRUE~NA_real_),
    PHQ9_Category_Num=case_when(PHQ9_SCORE>=20~5,PHQ9_SCORE>=15~4,
                                PHQ9_SCORE>=10~3,PHQ9_SCORE>=5~2,PHQ9_SCORE>=1~1,PHQ9_SCORE==0~0,TRUE~NA_real_),
    PHQ9_Category=factor(case_when(PHQ9_SCORE>=20~"Severe",
                                   PHQ9_SCORE>=15~"Moderately severe",PHQ9_SCORE>=10~"Moderate",
                                   PHQ9_SCORE>=5~"Mild",PHQ9_SCORE>=1~"Minimal",PHQ9_SCORE==0~"None",
                                   TRUE~NA_character_),levels=c("None","Minimal","Mild","Moderate",
                                                                "Moderately severe","Severe")),CYCLE=cycle_label)}


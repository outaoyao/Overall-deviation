run_sens_rcs<-function(outcome_var,outcome_label){
  make_rcs_s<-function(dat){R<-as.data.frame(Hmisc::rcspline.eval(dat$sleep_rhythm_index_z,knots=knots,inclx=TRUE)); names(R)<-paste0("RCS",seq_len(ncol(R))); bind_cols(dat,R)}
  fits<-lapply(MI_sens,function(d){z<-make_rcs_s(d); rr<-grep("^RCS",names(z),value=TRUE); des<-svydesign(id=~SDMVPSU,strata=~SDMVSTRA,weights=~mec_adj,nest=TRUE,data=z); svyglm(as.formula(paste(outcome_var,"~",paste(c(rr,cov_model4),collapse="+"))),des,family=quasibinomial())})
  nm<-names(coef(fits[[1]])); if(!all(vapply(fits,function(f)identical(names(coef(f)),nm),logical(1))))stop("RCS coefficient structure differs: ",outcome_label)
  rr<-grep("^RCS",nm,value=TRUE); ii<-match(rr,nm); Q<-do.call(cbind,lapply(fits,coef))[ii,,drop=FALSE]
  U<-array(NA_real_,c(length(ii),length(ii),M)); for(i in seq_len(M))U[,,i]<-vcov(fits[[i]])[ii,ii,drop=FALSE]
  dfs<-sapply(fits,function(f)f$df.residual); ov<-D1_test(Q,U,dfs); nl<-D1_test(Q[-1,,drop=FALSE],U[-1,-1,,drop=FALSE],dfs)
  lim<-as.numeric(quantile(MI_sens[[1]]$sleep_rhythm_index_z,c(.01,.99),names=FALSE)); xx<-seq(lim[1],lim[2],length.out=300)
  X<-as.matrix(Hmisc::rcspline.eval(xx,knots=knots,inclx=TRUE)); X0<-as.numeric(Hmisc::rcspline.eval(0,knots=knots,inclx=TRUE))
  curve<-map_dfr(seq_along(xx),function(j){d<-X[j,]-X0; QQ<-sapply(fits,function(f)sum(d*coef(f)[rr])); UU<-sapply(fits,function(f)as.numeric(t(d)%*%vcov(f)[rr,rr,drop=FALSE]%*%d)); z<-pool_BR(QQ,UU,dfs); tibble(exposure=xx[j],log_OR=z["est"],SE=z["se"],OR=exp(z["est"]),lower95=exp(z["lo"]),upper95=exp(z["hi"]))})
  curve<-bind_rows(curve,tibble(exposure=0,log_OR=0,SE=0,OR=1,lower95=1,upper95=1))%>%arrange(exposure)
  list(curve=curve,test=data.frame(Outcome=outcome_label,Test=c("Overall association","Nonlinear association"),P_value=c(ov$p,nl$p),P_formatted=fmt_p(c(ov$p,nl$p)),F_value=c(ov$F,nl$F),df1=c(ov$df1,nl$df1),df2=c(ov$df2,nl$df2)))}
sens_rcs<-imap(alt_outcomes,~run_sens_rcs(.x,.y))

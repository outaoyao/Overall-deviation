clean_special_codes<-function(x){
  z<-str_trim(as.character(x))
  z[z%in%c("",".","777","999","7777","9999","77777","99999",
           "Refused","Don't know","Don't Know","DK","NA")]<-NA_character_; z}
safe_numeric<-function(x) suppressWarnings(as.numeric(clean_special_codes(x)))
winsorize_duration<-function(x,lower=3,upper=14) pmin(pmax(as.numeric(x),lower),upper)

time_to_min<-function(x){
  z<-clean_special_codes(x)
  z<-case_when(str_detect(z,"^\\d{1,2}:\\d{2}$")~z,
               str_detect(z,"^\\d{3,4}$")~{p<-str_pad(z,4,pad="0");
               paste0(str_sub(p,1,2),":",str_sub(p,3,4))},TRUE~NA_character_)
  p<-str_split_fixed(z,":",2); h<-suppressWarnings(as.numeric(p[,1]))
  m<-suppressWarnings(as.numeric(p[,2])); total<-h*60+m; total[total==1440]<-0
  ifelse(!is.na(total)&total>=0&total<1440&m>=0&m<60,total,NA_real_)
}
calc_midpoint<-function(s,w){
  s<-time_to_min(s); w<-time_to_min(w)
  m<-ifelse(is.na(s)|is.na(w),NA_real_,ifelse(w>=s,s+(w-s)/2,s+(1440+w-s)/2))
  m%%1440}
min_to_hour_decimal<-function(x) x/60
min_to_hhmm<-function(x){y<-round(x)%%1440
ifelse(is.na(y),NA_character_,sprintf("%02d:%02d",y%/%60,y%%60))}

process_sleep_cycle<-function(raw_data,cycle_label){
  v<-c("SEQN","SLD012","SLD013","SLQ300","SLQ310","SLQ320","SLQ330")
  miss<-setdiff(v,names(raw_data)); if(length(miss)) stop("Missing variables: ",paste(miss,collapse=", "))
  raw_data %>% mutate(SEQN=safe_numeric(SEQN),CYCLE=cycle_label,
                      dur_wd_raw=safe_numeric(SLD012),dur_we_raw=safe_numeric(SLD013),
                      sleep_onset_wd_raw=clean_special_codes(SLQ300),
                      wake_time_wd_raw=clean_special_codes(SLQ310),
                      sleep_onset_we_raw=clean_special_codes(SLQ320),
                      wake_time_we_raw=clean_special_codes(SLQ330),
                      dur_wd_implausible_flag=case_when(is.na(dur_wd_raw)~NA_real_,
                                                        dur_wd_raw<3|dur_wd_raw>14~1,TRUE~0),
                      dur_we_implausible_flag=case_when(is.na(dur_we_raw)~NA_real_,
                                                        dur_we_raw<3|dur_we_raw>14~1,TRUE~0),
                      dur_wd=winsorize_duration(dur_wd_raw),dur_we=winsorize_duration(dur_we_raw),
                      sleep_onset_wd_min=time_to_min(sleep_onset_wd_raw),
                      wake_time_wd_min=time_to_min(wake_time_wd_raw),
                      sleep_onset_we_min=time_to_min(sleep_onset_we_raw),
                      wake_time_we_min=time_to_min(wake_time_we_raw),
                      sleep_onset_wd_hour=sleep_onset_wd_min/60,wake_time_wd_hour=wake_time_wd_min/60,
                      sleep_onset_we_hour=sleep_onset_we_min/60,wake_time_we_hour=wake_time_we_min/60,
                      midpoint_wd_min=calc_midpoint(sleep_onset_wd_raw,wake_time_wd_raw),
                      midpoint_we_min=calc_midpoint(sleep_onset_we_raw,wake_time_we_raw),
                      midpoint_wd_hour=midpoint_wd_min/60,midpoint_we_hour=midpoint_we_min/60,
                      midpoint_wd_hhmm=min_to_hhmm(midpoint_wd_min),
                      midpoint_we_hhmm=min_to_hhmm(midpoint_we_min),
                      SJL_raw_min=midpoint_we_min-midpoint_wd_min,
                      SJL_raw_min=case_when(SJL_raw_min>720~SJL_raw_min-1440,
                                            SJL_raw_min< -720~SJL_raw_min+1440,TRUE~SJL_raw_min),
                      SJL_abs_min=abs(SJL_raw_min),SJL_abs_hour=SJL_abs_min/60,
                      WCS_raw_hour=dur_we-dur_wd,WCS_abs_hour=abs(WCS_raw_hour),
                      dur_wd_cat=factor(case_when(dur_wd<7~"<7 hours",dur_wd<9~"7-9 hours",
                                                  dur_wd>=9~"≥9 hours"),levels=c("7-9 hours","<7 hours","≥9 hours")),
                      dur_we_cat=factor(case_when(dur_we<7~"<7 hours",dur_we<9~"7-9 hours",
                                                  dur_we>=9~"≥9 hours"),levels=c("7-9 hours","<7 hours","≥9 hours")),
                      dur_wd_cat_num=as.numeric(dur_wd_cat),dur_we_cat_num=as.numeric(dur_we_cat))}


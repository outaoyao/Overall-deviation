# Formal exposure × subgroup interaction | all 16 prespecified subgroups
run_interaction<-function(sub_var){clean_covs<-setdiff(all_covs,c(sub_var,redundancy_map[[sub_var]])); beta<-V<-vector("list",M); dfs<-rep(NA_real_,M)
  for(i in seq_len(M)){d<-MI_list[[i]]; vc<-clean_covs[sapply(clean_covs,function(v)n_unique(d[[v]])>=2)]
    f<-as.formula(paste(outcome_var,"~",paste0(exposure_var,"*",sub_var),if(length(vc))paste("+",paste(vc,collapse="+"))else""))
    fit<-tryCatch(svyglm(f,design=design_list[[i]],family=quasibinomial()),error=function(e)NULL)
    if(is.null(fit))return(tibble(Subgroup=sub_var,P_Interaction=NA,Interaction_F=NA,df1=NA,df2=NA,RIV=NA))
    beta[[i]]<-coef(fit); V[[i]]<-vcov(fit); dfs[i]<-fit$df.residual}
  if(!all(vapply(beta,function(x)identical(names(x),names(beta[[1]])),logical(1))))stop("Interaction coefficient structure differs: ",sub_var)
  it<-grep(paste0("^",exposure_var,":|:",exposure_var,"$"),names(beta[[1]]),value=TRUE)
  if(!length(it))return(tibble(Subgroup=sub_var,P_Interaction=NA,Interaction_F=NA,df1=NA,df2=NA,RIV=NA))
  Q<-do.call(cbind,lapply(beta,function(b)b[it])); U<-array(NA_real_,c(length(it),length(it),M)); for(i in seq_len(M))U[,,i]<-V[[i]][it,it,drop=FALSE]
  z<-D1_test(Q,U,dfs); tibble(Subgroup=sub_var,P_Interaction=z$p,Interaction_F=z$F,df1=z$df1,df2=z$df2,RIV=z$riv)}

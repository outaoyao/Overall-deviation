pool_vec<-function(z){Q<-do.call(rbind,lapply(z,`[[`,"q"));U<-lapply(z,`[[`,"U");m<-nrow(Q);list(Q=Q,U=U,q=colMeans(Q),T=Reduce("+",U)/m+(1+1/m)*cov(Q),m=m,dfcom=min(sapply(z,`[[`,"df")))}
D1<-function(p,ii){Q<-p$Q[,ii,drop=FALSE];U<-lapply(p$U,function(x)x[ii,ii,drop=FALSE]);m<-nrow(Q);k<-ncol(Q);qb<-colMeans(Q);ub<-Reduce("+",U)/m;B<-cov(Q);r<-(1+1/m)*sum(diag(solve(ub,B)))/k;Fv<-drop(t(qb)%*%solve(ub,qb))/(k*(1+r));df_old<-if(r<1e-12)1e6 else (m-1)*(1+1/r)^2;lam<-r/(1+r);df_obs<-((p$dfcom+1)/(p$dfcom+3))*p$dfcom*(1-lam);df2<-if(r<1e-12)p$dfcom else 1/(1/df_old+1/max(df_obs,1e-8));c(F=Fv,df1=k,df2=df2,P=pf(Fv,k,df2,lower.tail=FALSE))}
pool_contrast<-function(z,a){q<-sapply(z,function(x)sum(a*x$q));u<-sapply(z,function(x)drop(t(a)%*%x$U%*%a));pool_scalar(q,u,sapply(z,`[[`,"df"))}


    z<-pool_BR(est,se^2,df); tibble(Subgroup=sub_var,Level=as.character(lvl),n_unweighted=n,n_events=ev,beta=z["est"],se=z["se"],df=z["df"],OR=exp(z["est"]),lower95=exp(z["lo"]),upper95=exp(z["hi"]),p_value=z["p"])})}

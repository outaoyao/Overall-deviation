rcsb<-function(x,k){k<-sort(k);d<-k[4]-k[3];cbind(R1=x,R2=(tp(x,k[1])-(tp(x,k[3])*(k[4]-k[1])-tp(x,k[4])*(k[3]-k[1]))/d)/(k[4]-k[1])^2,R3=(tp(x,k[2])-(tp(x,k[3])*(k[4]-k[2])-tp(x,k[4])*(k[3]-k[2]))/d)/(k[4]-k[1])^2)}

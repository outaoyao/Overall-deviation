make_rcs<-function(dat){R<-as.data.frame(Hmisc::rcspline.eval(dat[[exposure]],knots=knots,inclx=TRUE)); names(R)<-paste0("RCS",seq_len(ncol(R))); bind_cols(dat,R)}
model_list<-lapply(MI_list,function(d){z<-make_rcs(d); rv<-grep("^RCS",names(z),value=TRUE); des<-svydesign(id=~SDMVPSU,strata=~SDMVSTRA,weights=~mec_adj,nest=TRUE,data=z); svyglm(as.formula(paste(outcome,"~",paste(c(rv,covariates),collapse="+"))),des,family=quasibinomial())})
saveRDS(model_list,file.path(out_dir20,"Step20_MI_RCS_models.rds"))
beta_list<-lapply(model_list,coef); vcov_list<-lapply(model_list,vcov); terms<-names(beta_list[[1]]); df_com<-sapply(model_list,function(x)x$df.residual)
if(!all(vapply(beta_list,function(x)identical(names(x),terms),logical(1))))stop("Coefficient structures differ.")
beta_matrix<-do.call(cbind,beta_list); W<-Reduce("+",vcov_list)/M; B<-cov(t(beta_matrix)); Tmat<-W+(1+1/M)*B
saveRDS(Tmat,file.path(out_dir20,"Step20_RCS_pooled_variance.rds"))

rcs_terms<-grep("^RCS",terms,value=TRUE); ii<-match(rcs_terms,terms); Q<-beta_matrix[ii,,drop=FALSE]; U<-array(NA_real_,c(length(ii),length(ii),M))
for(i in seq_len(M))U[,,i]<-vcov_list[[i]][ii,ii,drop=FALSE]
ov<-D1_test(Q,U,df_com); nl<-D1_test(Q[-1,,drop=FALSE],U[-1,-1,,drop=FALSE],df_com)
p_table<-data.frame(Test=c("Overall association","Nonlinear association"),P_value=c(ov$p,nl$p),P_formatted=fmt_p(c(ov$p,nl$p)),F_value=c(ov$F,nl$F),df1=c(ov$df1,nl$df1),df2=c(ov$df2,nl$df2),RIV=c(ov$riv,nl$riv),Method="D1 finite-df MI Wald test")

    geom_segment(data=minor,aes(x,y,xend=xend,yend=yend),linewidth=.22,colour="grey75")+
    geom_segment(data=major,aes(x,y,xend=xend,yend=yend),linewidth=.55,colour="grey45")+
    geom_text(data=labs,aes(x,y,label=label),size=3.7,fontface="bold")+
    annotate("text",x=0,y=0,label="24-hour\ncycle",size=4.8,fontface="bold",colour="#17365D")+
    geom_segment(data=sun,aes(x,y,xend=xend,yend=yend),linewidth=.65,colour="#E69F00")+
    annotate("point",x=0,y=-.67,shape=21,size=8,fill="#F0E442",colour="#E69F00",stroke=1)+
    annotate("point",x=0,y=.67,shape=21,size=8,fill="#17365D",colour="#17365D")+
    annotate("point",x=.035,y=.695,shape=21,size=7,fill="#DCE6F4",colour="#DCE6F4")+
    geom_segment(data=z,aes(x,y,xend=line_x,yend=line_y,colour=domain),linetype=2,linewidth=.5)+
    geom_point(data=z[day_type=="Weekend"],aes(x,y,colour=domain),shape=24,fill="white",size=5.2,stroke=1.1)+
    geom_point(data=z[day_type=="Weekday"],aes(x,y,fill=domain),shape=21,size=3.8,colour="white",stroke=.65)+
    geom_label(data=z,aes(lx,ly,label=paste0(label,"\n",time),colour=domain,hjust=hj),fill="white",size=3.3,
               lineheight=1.05,label.padding=unit(.20,"lines"),show.legend=FALSE)+
    scale_colour_manual(values=cols)+scale_fill_manual(values=cols)+
    coord_equal(xlim=c(-2.10,2.10),ylim=c(-1.42,1.42),clip="off")+theme_void(base_size=11)+
    theme(legend.position="bottom",legend.title=element_blank(),plot.margin=margin(20,40,20,40))
}


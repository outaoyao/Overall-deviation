run_subgroup<-function(sub_var,min_n=50){lvls<-levels(droplevels(MI_list[[1]][[sub_var]])); clean_covs<-setdiff(all_covs,c(sub_var,redundancy_map[[sub_var]]))
  map_dfr(lvls,function(lvl){idx0<-MI_list[[1]][[sub_var]]==lvl; idx0[is.na(idx0)]<-FALSE; n<-sum(idx0); ev<-sum(MI_list[[1]][[outcome_var]][idx0]==1,na.rm=TRUE)
    if(n<min_n)return(tibble(Subgroup=sub_var,Level=lvl,n_unweighted=n,n_events=ev,beta=NA,se=NA,df=NA,OR=NA,lower95=NA,upper95=NA,p_value=NA))
    vc<-clean_covs[sapply(clean_covs,function(v)n_unique(MI_list[[1]][idx0,,drop=FALSE][[v]])>=2)]; est<-se<-df<-rep(NA_real_,M)
    for(i in seq_len(M)){
      idx<-MI_list[[i]][[sub_var]]==lvl; idx[is.na(idx)]<-FALSE
      fit<-tryCatch(svyglm(as.formula(paste(outcome_var,"~",exposure_var,if(length(vc))paste("+",paste(vc,collapse="+"))else"")),design=subset(design_list[[i]],idx),family=quasibinomial()),error=function(e)NULL)

if(!is.finite(T)||T<0) stop("Invalid Rubin variance."); if(T==0)return(c(est=q,se=0,df=min(dfcom),lo=q,hi=q,p=NA)); lam<-(1+1/m)*b/T; old<-if(lam>0)(m-1)/lam^2 else Inf;
dc<-min(dfcom[is.finite(dfcom)&dfcom>0]); obs<-((dc+1)/(dc+3))*dc*(1-lam); df<-if(is.finite(old))1/(1/old+1/obs) else obs; se<-sqrt(T); cr<-qt(.975,df);
c(est=q,se=se,df=df,lo=q-cr*se,hi=q+cr*se,p=2*pt(-abs(q/se),df))}

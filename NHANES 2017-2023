time_min<-function(x){z<-trimws(as.character(x));vapply(z,function(a){if(is.na(a)||a=="")return(NA_real_);if(grepl(":",a,fixed=TRUE)){q<-num(strsplit(a,":",fixed=TRUE)[[1]]);if(length(q)!=2)return(NA_real_);h<-q[1];m<-q[2]}else{q<-num(a);if(!is.finite(q))return(NA_real_);h<-floor(q/100);m<-q%%100};if(!is.finite(h)||!is.finite(m)||h<0||h>24||m<0||m>=60||(h==24&&m!=0))NA_real_ else (h*60+m)%%1440},numeric(1))}
midpoint<-function(a,b){a<-time_min(a);b<-time_min(b);(a+((b-a)%%1440)/2)%%1440}
circ_dist<-function(x,r)abs(((x-r+12)%%24)-12)

pool1<-function(z){q<-z[,"beta"];u<-z[,"SE"]^2;dc<-z[,"dfcom"];m<-length(q);qb<-mean(q);ub<-mean(u);B<-var(q);T<-ub+(1+1/m)*B
lam<-if(T>0)(1+1/m)*B/T else 0;do<-if(lam<=0)Inf else (m-1)/lam^2;d<-dc[is.finite(dc)&dc>0];d<-if(length(d))min(d) else Inf
dob<-if(is.finite(d))((d+1)/(d+3))*d*(1-lam) else Inf;df<-if(is.finite(do)&&is.finite(dob))1/(1/do+1/dob) else min(do,dob)
se<-sqrt(T);cr<-if(is.finite(df))qt(.975,df) else qnorm(.975);p<-if(is.finite(df))2*pt(abs(qb/se),df,lower.tail=FALSE) else 2*pnorm(abs(qb/se),lower.tail=FALSE)
c(Beta=qb,SE=se,CI_lower=qb-cr*se,CI_upper=qb+cr*se,P=p,DF=df,FMI=lam)}
fit1<-function(d,f,t){x<-svyglm(f,d);a<-coef(summary(x));c(beta=a[t,1],SE=a[t,2],dfcom=degf(d))}
fitlog<-function(d,f,t){x<-svyglm(f,d,family=quasibinomial());a<-coef(summary(x));c(beta=a[t,1],SE=a[t,2],dfcom=degf(d))}


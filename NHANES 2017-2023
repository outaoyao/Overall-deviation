wquantile<-function(x,w,p=c(.1,.9)){ok<-is.finite(x)&is.finite(w)&w>0;x<-x[ok];w<-w[ok];o<-order(x);x<-x[o];w<-w[o];cw<-cumsum(w)/sum(w);sapply(p,function(z)x[which(cw>=z)[1]])}
